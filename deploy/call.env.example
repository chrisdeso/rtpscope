# call.env --> settings the call server reads from the environment
# on the vps setup.sh writes the real one to /etc/rtpscope/call.env (mode 600), this is just the shape.
# locally: cp deploy/call.env.example call.env, fill it in, then
#   set -a; . ./call.env; set +a; .venv/bin/python -m rtpscope.call.server
# (call.env is gitignored, this .example isn't)

# comma separated, handed to every browser on join
STUN_URL=stun:call.example.com:3478
TURN_URL=turn:call.example.com:3478?transport=udp,turn:call.example.com:3478?transport=tcp

# shared with coturn's static-auth-secret, make one with: openssl rand -hex 32
TURN_SECRET=change-me
